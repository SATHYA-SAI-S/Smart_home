# SentinelHome Backend Server Environment
PORT=3001
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Fallback Settings (Safety net if Gemini hits rate limits)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_MS=6000
# Set PREFER_OLLAMA=true to run exclusively on local Ollama during presentations
PREFER_OLLAMA=false

